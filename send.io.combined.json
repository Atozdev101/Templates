{
    "providerId": "send.io",
    "providerName": "send.io",
    "serviceId": "combined",
    "serviceName": "send.io email",
    "version": 1,
    "logoUrl": "https://app.send.io/favicon.svg",
    "description": "Sends email for this domain through send.io: one DKIM key and a return path that work for every send.io sending route, plus optional receiving.",
    "variableDescription": "selector: the DKIM selector (e.g. sio1); dkimkey: the domain's key label in send.io's key zone; inboundHost: the send.io inbound host label (e.g. mx).",
    "syncPubKeyDomain": "send.io",
    "syncRedirectDomain": "app.send.io",
    "records": [
        {
            "type": "CNAME",
            "groupId": "dkim",
            "host": "%selector%._domainkey",
            "pointsTo": "%dkimkey%.dkim.sendiodns.com",
            "ttl": "3600"
        },
        {
            "type": "CNAME",
            "groupId": "outbound",
            "host": "send",
            "pointsTo": "rp.sendiodns.com",
            "ttl": "3600"
        },
        {
            "type": "TXT",
            "groupId": "dmarc",
            "essential": "OnApply",
            "host": "_dmarc",
            "ttl": "3600",
            "data": "v=DMARC1; p=none;",
            "txtConflictMatchingMode": "Prefix",
            "txtConflictMatchingPrefix": "v=DMARC1"
        },
        {
            "type": "MX",
            "groupId": "inbound",
            "host": "@",
            "pointsTo": "%inboundHost%.sendiodns.com",
            "ttl": "3600",
            "priority": "10"
        }
    ]
}
